# ============================================================
# Built-in action descriptions (src/ui/menu/editor/builtins.rs)
# ============================================================
#: src/ui/menu/editor/builtins.rs:11
msgid "Copies the selected files or folders to the clipboard."
msgstr "選択したファイルまたはフォルダーをクリップボードにコピーします。"

#: src/ui/menu/editor/builtins.rs:16
msgid "Cuts the selected files or folders to the clipboard."
msgstr "選択したファイルまたはフォルダーを切り取ってクリップボードに置きます。"

#: src/ui/menu/editor/builtins.rs:21
msgid "Pastes items from the clipboard into the current directory."
msgstr "クリップボードの項目を現在のディレクトリに貼り付けます。"

#: src/ui/menu/editor/builtins.rs:26
msgid "Opens the selected folder or current location in a new tab."
msgstr "選択したフォルダーまたは現在の場所を新しいタブで開きます。"

#: src/ui/menu/editor/builtins.rs:31
msgid "Triggers inline filename renaming on the selected item."
msgstr "選択項目のファイル名のインライン名前変更を開始します。"

#: src/ui/menu/editor/builtins.rs:36
msgid "Moves the selected files or folders to the system trash."
msgstr "選択したファイルまたはフォルダーをシステムのごみ箱に移動します。"

#: src/ui/menu/editor/builtins.rs:41
msgid "Opens the new folder creation prompt."
msgstr "新規フォルダー作成のプロンプトを開きます。"

#: src/ui/menu/editor/builtins.rs:46
msgid "Opens the new file creation prompt."
msgstr "新規ファイル作成のプロンプトを開きます。"

#: src/ui/menu/editor/builtins.rs:51
msgid "Pins or unpins the target folder in the sidebar."
msgstr "対象のフォルダーをサイドバーにピン留めまたは解除します。"

#: src/ui/menu/editor/builtins.rs:56
msgid "Adds the selected folder or current directory to the Quick List."
msgstr ""
"選択したフォルダーまたは現在のディレクトリをクイックリストに追加します。"

#: src/ui/menu/editor/builtins.rs:61
msgid "Opens a submenu to move or copy items directly to Quick List slots."
msgstr ""
"項目をクイックリストのスロットに直接移動またはコピーするサブメニューを開きま"
"す。"

#: src/ui/menu/editor/builtins.rs:66
msgid "Opens the file tag editor popover."
msgstr "ファイルタグエディターのポップオーバーを開きます。"

#: src/ui/menu/editor/builtins.rs:71
msgid "Opens the Directory Inspector with disk usage and largest files."
msgstr "ディスク使用量と最大ファイルを含むフォルダーインスペクターを開きます。"

#: src/ui/menu/editor/builtins.rs:76
msgid "Installs the selected font files into ~/.local/share/fonts."
msgstr "選択したフォントファイルを ~/.local/share/fonts にインストールします。"

#: src/ui/menu/editor/builtins.rs:81
msgid ""
"Populates a dynamic submenu of registered applications for the MIME type."
msgstr ""
"MIME タイプに登録されているアプリケーションの動的サブメニューを生成します。"

#: src/ui/menu/editor/builtins.rs:86
msgid "Opens the full system application chooser dialog."
msgstr "システム全体のアプリケーション選択ダイアログを開きます。"

#: src/ui/menu/editor/builtins.rs:91
msgid "Opens the folder icon picker to assign a theme icon."
msgstr "テーマアイコンを割り当てるフォルダーアイコンピッカーを開きます。"

#: src/ui/menu/editor/builtins.rs:96
msgid "Opens a file chooser to assign a custom image as file/folder icon."
msgstr ""
"カスタム画像をファイル/フォルダーアイコンとして割り当てるファイル選択ダイアロ"
"グを開きます。"

#: src/ui/menu/editor/builtins.rs:101
msgid "Restores the default icon for the selected file or folder."
msgstr "選択したファイルまたはフォルダーの既定アイコンを復元します。"

#: src/ui/menu/editor/builtins.rs:106
msgid "Sets a custom image icon for the target file's extension globally."
msgstr ""
"対象ファイルの拡張子に対してカスタム画像アイコンをグローバルに設定します。"

#: src/ui/menu/editor/builtins.rs:111
msgid "Resets the custom icon for the target extension back to theme default."
msgstr "対象拡張子のカスタムアイコンをテーマの既定に戻します。"

#: src/ui/menu/editor/builtins.rs:116
msgid "Sets the selected image as the main window background."
msgstr "選択した画像をメインウィンドウの背景に設定します。"

#: src/ui/menu/editor/builtins.rs:121
msgid "Sets the selected image as the left sidebar background."
msgstr "選択した画像を左サイドバーの背景に設定します。"

#: src/ui/menu/editor/builtins.rs:126
msgid "Sets the selected image as the right panel background."
msgstr "選択した画像を右パネルの背景に設定します。"

#: src/ui/menu/editor/builtins.rs:131
msgid "Clears all custom background images and resets styling to default."
msgstr "すべてのカスタム背景画像を消去し、スタイルを既定に戻します。"

