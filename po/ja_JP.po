msgstr "{total} 個中 {count} 個のファイルを #{tag} としてタグ付けしました"

#: src/ui/dialog/save_search_as_tag.rs:31
msgid "Save Search as Tag"
msgstr "検索をタグとして保存"

#: src/ui/dialog/save_search_as_tag.rs:41
msgid "Tag name"
msgstr "タグ名"

#: src/ui/dialog/save_search_as_tag.rs:48
msgid "Pin to sidebar"
msgstr "サイドバーにピン留め"

#: src/ui/dialog/save_search_as_tag.rs:21
msgid "{count} files will be tagged."
msgstr "{count} 個のファイルがタグ付けされます。"

#: src/ui/dialog/save_search_as_tag.rs:25
msgid "{count} files will be tagged #{tag}."
msgstr "{count} 個のファイルが #{tag} としてタグ付けされます。"

#: src/ui/dialog/save_search_as_tag.rs:33
msgid "New files matching this search will not be tagged automatically."
msgstr "この検索に一致する新しいファイルは自動的にはタグ付けされません。"

